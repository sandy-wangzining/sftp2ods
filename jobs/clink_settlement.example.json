{
  "//说明": "Clink 结算文件（SFTP /statements/settlement_report_YYYYMMDD.csv）→ sitindw.ods_clink_settlement_details_di；等价于旧脚本 clink_settlement_sync/clink_settlement_sync.py",
  "job": "clink_settlement",
  "description": "Clink 结算文件（SFTP）→ ods_clink_settlement_details_di（pt=结算文件日期）",
  "secrets": {
    "feishu_webhook": "https://open.feishu.cn/open-apis/bot/v2/hook/xxx"
  },
  "maxcompute": {
    "project": "sitindw",
    "endpoint": "http://service.us-west-1.maxcompute.aliyun.com/api",
    "access_key_id": "<阿里云 AK>",
    "access_key_secret": "<阿里云 SK>"
  },
  "sftp": {
    "host": "sftp.clinkbill.com",
    "port": 2022,
    "username": "mcht_xxx",
    "auth": {
      "type": "key",
      "key_file": "~/.ssh/clink_sftp"
    }
  },
  "source": {
    "root": "/statements",
    "layout": "flat",
    "file_regex": "settlement_report_(?P<date>\\d{8})\\.csv"
  },
  "parse": {
    "encoding": "utf-8-sig",
    "delimiter": "auto",
    "//empty_as": "空串按旧脚本口径原样存 ''（与既有表数据一致）；新接源建议用默认 null（空串存 NULL）",
    "empty_as": "empty",
    "footer": {
      "//说明": "末尾合计行（首列为空）不写库；金额列核对「合计=数据行之和」",
      "sum": ["settlement_amount", "fee_amount", "deposit_amount", "tax_settlement_amount", "net_settlement_amount"]
    },
    "columns": [
      { "header": "Tenant name", "name": "tenant_name", "type": "string", "comment": "Tenant name（租户名）" },
      { "header": "Merchant name", "name": "merchant_name", "type": "string", "comment": "Merchant name（商户名）" },
      { "header": "Merchant ID", "name": "merchant_id", "type": "string", "comment": "Merchant ID（商户 ID）" },
      { "header": "Transaction type", "name": "transaction_type", "type": "string", "comment": "Transaction type（payment/refund 等）" },
      { "header": "Order ID", "name": "order_id", "type": "string", "comment": "Order ID（Clink 订单号）" },
      { "header": "Txn ID", "name": "txn_id", "type": "string", "comment": "Txn ID（渠道交易号，可能为空）" },
      { "header": "Merchant reference", "name": "merchant_reference", "type": "string", "comment": "Merchant reference（商户侧参考号）" },
      { "header": "Payment method", "name": "payment_method", "type": "string", "comment": "Payment method（APPLEPAY/CARD/CASHAPP 等）" },
      { "header": "Time zone", "name": "time_zone", "type": "string", "comment": "Time zone（时区，如 Etc/GMT）" },
      { "header": "Created time", "name": "created_time", "type": "string", "comment": "Created time（创建时间原文）" },
      { "header": "Settlement time", "name": "settlement_time", "type": "string", "comment": "Settlement time（结算时间，可能为空）" },
      { "header": "Transaction amount", "name": "transaction_amount", "type": "decimal(19,10)", "comment": "Transaction amount（交易金额）" },
      { "header": "Transaction currency", "name": "transaction_currency", "type": "string", "comment": "Transaction currency（交易币种）" },
      { "header": "Payment amount", "name": "payment_amount", "type": "decimal(19,10)", "comment": "Payment amount（支付金额）" },
      { "header": "Payment currency", "name": "payment_currency", "type": "string", "comment": "Payment currency（支付币种）" },
      { "header": "Settlement currency", "name": "settlement_currency", "type": "string", "comment": "Settlement currency（结算币种）" },
      { "header": "Exchange rate", "name": "exchange_rate", "type": "string", "comment": "Exchange rate（汇率原文，可能为空）" },
      { "header": "Settlement amount", "name": "settlement_amount", "type": "decimal(19,10)", "comment": "Settlement amount（结算金额）" },
      { "header": "Fee amount", "name": "fee_amount", "type": "decimal(19,10)", "comment": "Fee amount（渠道费，负数=扣费）" },
      { "header": "Deposit amount", "name": "deposit_amount", "type": "decimal(19,10)", "comment": "Deposit amount（留存/保证金，负数=扣）" },
      { "header": "Tax settlement amount", "name": "tax_settlement_amount", "type": "decimal(19,10)", "comment": "Tax settlement amount（税费结算额）" },
      { "header": "Net settlement amount", "name": "net_settlement_amount", "type": "decimal(19,10)", "comment": "Net settlement amount（净结算额）" },
      { "header": "Tax amount", "name": "tax_amount", "type": "decimal(19,10)", "comment": "Tax amount（税额）" },
      { "header": "Tax currency", "name": "tax_currency", "type": "string", "comment": "Tax currency（税币种）" },
      { "header": "Tax exchange rate", "name": "tax_exchange_rate", "type": "string", "comment": "Tax exchange rate（汇率原文）" },
      { "header": "Payout batch number", "name": "payout_batch_number", "type": "string", "comment": "Payout batch number（打款批次号）" },
      { "header": "Description", "name": "description", "type": "string", "comment": "Description（备注）" }
    ]
  },
  "target": {
    "project": "sitindw",
    "table": "ods_clink_settlement_details_di",
    "comment": "Clink 结算文件（SFTP settlement_report CSV 列展开，pt=结算文件日期）"
  },
  "missing": {
    "check": true,
    "timezone": "UTC",
    "grace": "02:30"
  },
  "notify": {
    "webhook": "${secrets.feishu_webhook}"
  }
}
